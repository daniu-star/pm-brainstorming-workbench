{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "node_modules/.cache/render-build",
    "rootDir": ".",
    "declaration": false,
    "sourceMap": false,
    "incremental": false,
    "isolatedModules": false,
    "jsx": "react-jsx",
    "allowJs": false
  },
  "include": [],
  "files": [
    "app/session/[id]/audit/page.tsx",
    "app/session/[id]/loop/page.tsx",
    "components/Toast.tsx",
    "components/brief/BriefCard.tsx",
    "components/canvas/CanvasPanel.tsx",
    "components/chat/MessageBubble.tsx",
    "components/chat/MessageList.tsx",
    "components/evidence/EvidenceForm.tsx",
    "components/share/SharePanel.tsx",
    "components/icons/index.tsx",
    "lib/api.ts",
    "lib/auditView.ts",
    "lib/briefDraft.ts",
    "lib/chatNotices.ts",
    "lib/contracts.generated.ts",
    "lib/loopView.ts",
    "lib/phaseRouter.ts",
    "lib/sse.ts",
    "lib/stateGuards.ts",
    "lib/types.ts",
    "store/sessionStore.ts"
  ]
}
