LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_EMBEDDING_MODEL=text-embedding-3-small
# LLM 流式调用超时（秒）与重试次数
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
# 多角色脑暴的并发间隔（秒，0 表示不等待）
AGENT_ROLE_INTERVAL=0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional server-side speech recognition. When omitted, the frontend falls
# back to the browser speech recognition service.
STT_API_KEY=your-stt-api-key-here
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1
STT_LANGUAGE=zh
STT_TIMEOUT_SECONDS=45
STT_MAX_AUDIO_BYTES=12582912
# 单次录音最大时长（秒），前端倒计时提示与后端 capabilities 均使用
STT_MAX_RECORDING_SECONDS=300

TTS_TIMEOUT_SECONDS=30
TTS_MAX_CHARACTERS=3000

# 网易邮箱 SMTP（SMTP_PASSWORD 使用客户端授权码，不是邮箱登录密码）
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USERNAME=your-account@163.com
SMTP_PASSWORD=your-smtp-authorization-code
SMTP_FROM=your-account@163.com
SMTP_USE_SSL=true
SMTP_TIMEOUT_SECONDS=20

# 邮箱验证码登录。生产环境请生成至少 32 字符的随机值并设置 AUTH_COOKIE_SECURE=true。
AUTH_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
AUTH_COOKIE_NAME=pm_brainstorm_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_SESSION_DAYS=7
AUTH_CODE_EXPIRE_MINUTES=10
AUTH_CODE_RESEND_SECONDS=60
