LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_EMBEDDING_MODEL=text-embedding-3-small
# LLM 流式调用超时（秒）与重试次数
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
# 预算档位：standard（契约默认）/ lean（低成本）/ frugal（最低成本）。
# 只收紧不下调契约上限，生效值写入每条 Run 的 budget_json。
LLM_BUDGET_PROFILE=standard
# 推理型模型（如 deepseek-flash）会把 completion 预算先花在 reasoning_content 上，
# 导致结构化输出 content 为空；默认关闭思考，设为 false 可恢复供应商默认行为。
# LLM_DISABLE_REASONING=true
# 多角色脑暴的并发间隔（秒，0 表示不等待）
AGENT_ROLE_INTERVAL=0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional server-side speech recognition. When omitted, the frontend falls
# back to the browser speech recognition service.
STT_API_KEY=your-stt-api-key-here
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1
STT_LANGUAGE=zh
STT_TIMEOUT_SECONDS=45
STT_MAX_AUDIO_BYTES=12582912
# 单次录音最大时长（秒），前端倒计时提示与后端 capabilities 均使用
STT_MAX_RECORDING_SECONDS=300

TTS_TIMEOUT_SECONDS=30
TTS_MAX_CHARACTERS=3000

# 网易邮箱 SMTP（SMTP_PASSWORD 使用客户端授权码，不是邮箱登录密码）
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USERNAME=your-account@163.com
SMTP_PASSWORD=your-smtp-authorization-code
SMTP_FROM=your-account@163.com
SMTP_USE_SSL=true
SMTP_TIMEOUT_SECONDS=20

# 可选：SMTP 的 HTTP 代理。Hugging Face Space 等容器平台常封出站 25/465/587，
# 直连 SMTP 会超时；配置代理后验证码先 POST 给代理，失败再回落直连。
# EMAIL_PROXY_URL=https://your-mail-proxy.example.com/send
# EMAIL_PROXY_KEY=

# 邮件通道兜底：既没有可用 SMTP、也没有 HTTP 代理时，投递失败把验证码写进服务日志
# （只有平台所有者能读），接口立刻返回 delivery=logs，登录入口不会卡住。
# 只建议私有/自建部署开启；公开站点请改用 EMAIL_PROXY_URL 或配置可用 SMTP。
AUTH_CODE_LOG_FALLBACK=false

# 邮箱验证码登录。生产环境请生成至少 32 字符的随机值并设置 AUTH_COOKIE_SECURE=true。
AUTH_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
AUTH_COOKIE_NAME=pm_brainstorm_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_SESSION_DAYS=7
AUTH_CODE_EXPIRE_MINUTES=10
AUTH_CODE_RESEND_SECONDS=60

# 账户级配额（滚动 24 小时；0 = 不限，默认不限制）。
# 与单 Run 预算互补：单 Run 预算防一次性烧太多，账户配额防一个账号反复烧。
ACCOUNT_DAILY_TOKEN_LIMIT=0
ACCOUNT_DAILY_CALL_LIMIT=0

# 模型密钥模式：byok（默认）= 每个账户在「模型 API 设置」里填自己的 Key；system = 复用下面的 LLM_API_KEY（仅本地联调/自动化）
LLM_KEY_MODE=byok

# Loop Studio 执行沙箱（第 38 批）：fail-closed，默认关闭；进程级隔离不是安全边界。
# 开启后仍需白名单，且只建议在本地 / 受信环境使用。
LOOP_SANDBOX_ENABLED=false
LOOP_SANDBOX_ALLOWED_COMMANDS=
LOOP_SANDBOX_TIMEOUT_SECONDS=20
LOOP_SANDBOX_MAX_OUTPUT_BYTES=8192
