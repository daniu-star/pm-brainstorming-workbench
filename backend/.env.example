LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_MAX_OUTPUT_TOKENS=2500
JWT_SECRET=replace-with-a-long-random-secret
ALLOW_ANONYMOUS_TOKENS=false
ALLOW_SMS_CODE_ECHO=false
GUEST_INITIAL_QUOTA=20000
CORS_ALLOWED_ORIGINS=https://www.brainstorming.top,https://brainstorming.top,http://localhost:3000
TEAM_DATA_DIR=./data/teams
FRONTEND_BASE_URL=https://www.brainstorming.top
TEAM_INVITE_EXPIRY_HOURS=72

# 团队邀请邮件（生产环境建议作为部署平台 Secret 配置）
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=产品脑暴工作台
SMTP_USE_TLS=true
SMTP_USE_SSL=false
LLM_EMBEDDING_MODEL=text-embedding-3-small

# HuggingFace API Token - 免费 Whisper 语音转文字备用方案
# 获取方式: https://huggingface.co/settings/tokens
HF_API_TOKEN=

# 语音服务独立配置。STT 模型不能复用聊天模型名。
STT_MODEL=whisper-1
STT_TIMEOUT_SECONDS=45
STT_MAX_AUDIO_BYTES=12582912
TTS_TIMEOUT_SECONDS=45
TTS_MAX_CHARACTERS=3000
